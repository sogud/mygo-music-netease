{
  "id": "netease",
  "name": "网易云音乐",
  "version": "0.1.15",
  "minAppVersion": "0.1.21",
  "main": "index.js",
  "playback": "stream",
  "permissions": {
    "network": ["music.163.com", "interfacepc.music.163.com", "*"],
    "process": ["powershell", "base64"]
  },
  "settings": [
    {
      "key": "customSource",
      "label": "自定义音源脚本",
      "help": "填洛雪音乐（LX Music）自定义音源脚本的 https:// 链接，或本机文件路径（如 C:\\Users\\你\\Downloads\\音源.js，带空格就加英文引号），多个用空格分开。用本地文件要先在本页点「允许运行程序」。网易云自己有完整音源时不会用到它，只有放不了歌时才向它要音频；脚本需声明「网易云」源。"
    }
  ],
  "navigation": [
    { "title": "发现音乐", "builtin": "home" },
    { "title": "私人漫游", "builtin": "stations" },
    { "title": "排行榜", "page": "charts", "icon": "chart" },
    { "title": "我喜欢的音乐", "builtin": "liked" },
    { "title": "我的播客", "builtin": "shows" },
    { "title": "自定义音源", "page": "sources", "icon": "radio" }
  ]
}
